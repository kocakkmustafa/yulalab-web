{
  "name": "yulalab.com",
  "version": "0.1.0",
  "private": true,
  "description": "YULA Lab — umbrella corporate site showcasing the company's ventures.",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:registry": "tsx scripts/export-public-registry.ts",
    "verify:claims": "tsx scripts/verify-public-registry.ts",
    "verify:links": "tsx scripts/verify-public-links.ts",
    "verify:claims:local": "node scripts/verify-claims-local.mjs",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "next-intl": "^4.11.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vercel": "^53.3.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.3",
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18"
    }
  },
  "engines": {
    "node": ">=20.11"
  }
