# Public site origin used by sitemap, robots, OpenGraph and metadataBase.
# Production: https://yulalab.com
# Preview deployments fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://yulalab.com

# ── Attribution (Y-P0-004) ────────────────────────────────────────────
# THE SWITCH for the whole funnel. Off unless set to exactly "1".
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time — changing it in the Vercel
# dashboard does nothing until the next deploy. The links hub has its own
# `var ENABLED` in links/index.html; flip both in the same change, and update
# the "currently OFF" sentence on /privacy in that same change, or the public
# page starts lying (tests/privacy-claim-anchor.test.ts guards the hub half).
NEXT_PUBLIC_ATTRIBUTION_ENABLED=

# PostgreSQL for leads, consents and attribution. Deliberately SEPARATE
# from every product database — nothing here may be joined against LifeOS,
# Burun Farkı or Braavolabs user data.
#
# When this is unset, POST /api/events answers 503 {stored:false} rather
# than a silent 202. That is intentional: a 202 would make dropped events
# indistinguishable from stored ones and would inflate the
# attribution-completeness metric with rows that never existed.
DATABASE_URL=postgres://user:password@host:5432/yula_attribution

# Server-only HMAC key for the daily-rotating session pseudonym. Must be a
# long random string. There is NO fallback: hashing with a constant would
# produce a permanently joinable identifier, so a missing secret makes the
# events endpoint report storage as unavailable instead.
#   openssl rand -hex 32
ATTRIBUTION_SECRET=

# Database the attribution test-suite runs against. Defaults to
# postgres://localhost:5432/yula_attribution_test. These tests intentionally
# run against a real PostgreSQL — a fake store would accept the very rows
# the schema exists to reject, so a green run against one proves nothing.
#   createdb yula_attribution_test
ATTRIBUTION_TEST_DATABASE_URL=postgres://localhost:5432/yula_attribution_test

# Bearer token Vercel Cron sends to /api/purge, which enforces the 30-day
# raw-attribution retention promised on /privacy. Unset means the route
# refuses to run at all — a public endpoint that deletes rows must not be
# reachable just because nobody configured it.
#   openssl rand -hex 32
CRON_SECRET=
